# Copy to .env at the repo root and adjust as needed. docker-compose reads
# these automatically.
SECRET_KEY=change-me-in-production-please
SIMULATOR_FLIGHT_COUNT=500
SIMULATOR_GATE_COUNT=90

# Optional: leave blank to run fully offline on the built-in heuristic
# reasoning engine (recommended for demos). Set both to enable live LLM
# narration/chat via the OpenAI-compatible API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
